---
import { LANGS, useT, type Lang } from '../../../i18n';
import { MODALITIES } from '../../../data/event';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Accordion from '../../../components/Accordion.astro';
import PriceTable from '../../../components/PriceTable.astro';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang), r = t.rulesPage;
const site = Astro.site!.href.replace(/\/$/, '');
const jsonld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: t.breadcrumb.home, item: `${site}/${lang}/` },
  { '@type': 'ListItem', position: 2, name: r.title, item: `${site}/${lang}/rules/` }] }];
---
<Base lang={lang} path="rules/" title={`${r.title} · MM Igualada`} description={r.metaDesc} jsonld={jsonld}>
  <div class="mx-auto max-w-4xl px-5 pb-10 pt-32 sm:px-8 md:pt-40">
    <Breadcrumb lang={lang} current={r.title} />
    <h1 class="mt-6 text-4xl font-extrabold sm:text-6xl">{r.title}</h1>
    <p class="mt-4 text-lg" style="color:var(--muted)">{r.lead}</p>
    <p class="glass mt-6 rounded-2xl px-5 py-4 text-sm font-semibold" role="note">ℹ️ {r.homolog}</p>

    <h2 class="mt-14 text-3xl font-extrabold">{r.cutoffs}</h2>
    <div class="glass mt-5 overflow-x-auto rounded-[1.75rem] p-2">
      <table class="w-full min-w-[30rem] text-left">
        <thead><tr class="text-sm" style="color:var(--muted)"><th scope="col" class="p-3">{r.cols.mod}</th><th scope="col" class="p-3">{r.cols.start}</th><th scope="col" class="p-3">{r.cols.cut}</th><th scope="col" class="p-3">{r.cols.age}</th></tr></thead>
        <tbody>
          {MODALITIES.map((m) => (
            <tr class="border-t" style="border-color:var(--line)">
              <th scope="row" class="p-3 font-bold">{t.modalities.items[m.id].name} <span class="text-sm font-normal" style="color:var(--muted)">· {m.km} km</span></th>
              <td class="font-display p-3 text-xl font-extrabold">{m.start}</td><td class="font-display p-3 text-xl font-extrabold">{m.cutoff}</td>
              <td class="p-3">{m.minAge ? `${m.minAge} ${t.modalities.years}` : t.modalities.allAges}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-14 text-3xl font-extrabold">{r.pricesTitle}</h2>
    <div class="mt-5"><PriceTable lang={lang} /></div>

    <h2 class="mt-14 text-3xl font-extrabold">{t.rules.title}</h2>
    <div class="mt-5"><Accordion items={t.rules.items} name="r1" /></div>
    <h2 class="mt-14 text-3xl font-extrabold">{r.more}</h2>
    <div class="mt-5"><Accordion items={r.items} name="r2" /></div>

    <div class="mt-12 flex flex-wrap gap-3">
      <a href={`/${lang}/#inscripcions`} class="btn btn-primary">{t.cta.register} <span class="arrow" aria-hidden="true">→</span></a>
      <a href={`/${lang}/#contacte`} class="btn btn-ghost">{t.nav.contact}</a>
    </div>
  </div>
</Base>
