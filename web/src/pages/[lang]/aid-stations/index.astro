---
import { LANGS, useT, type Lang } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LogisticsMap from '../../../components/LogisticsMap.astro';
import D from '../../../data/logistics.json';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang), l = t.logistics, a = l.aid;
const site = Astro.site!.href.replace(/\/$/, '');
const jsonld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: t.breadcrumb.home, item: `${site}/${lang}/` },
  { '@type': 'ListItem', position: 2, name: a.title, item: `${site}/${lang}/aid-stations/` }] }];
type Id = '21k' | '10k' | 'cam';
const COL: Record<string, string> = { '21k': 'var(--c21)', '10k': 'var(--c10)', cam: 'var(--ccam)' };
const dec = (v: number, d = 1) => v.toFixed(d).replace('.', lang === 'en' ? '.' : ',');
const gm = (la: number, lo: number) => `https://www.google.com/maps/search/?api=1&query=${la},${lo}`;
const defaults: Record<Id, number> = { '21k': 300, '10k': 350, cam: 150 }; // PLACEHOLDER: repartiment dels 800 participants del pressupost
const cols = ['pass', 'water', 'iso', 'cups', 'fruit', 'tanks', 'tables', 'vols'] as const;
const icons = ['M8 3h8l-1 18H9zM7 8h10', 'M12 3a9 9 0 1 0 9 9M12 8a4 4 0 1 0 4 4M12 12h.01', 'M5 10h14v4a7 7 0 0 1-14 0zM9 3v3M13 3v3', 'M4 20l4-9 4 5 3-7 5 11M12 4h.01', 'M12 3v6M7 9h10l-1 12H8zM9 13h6', 'M12 3c4 5 6 8 6 11a6 6 0 0 1-12 0c0-3 2-6 6-11z'];
---
<Base lang={lang} path="aid-stations/" title={`${a.title} · MM Igualada`} description={a.metaDesc} jsonld={jsonld}>
  <div class="mx-auto max-w-6xl px-5 pb-10 pt-32 sm:px-8 md:pt-40">
    <Breadcrumb lang={lang} current={a.title} />
    <p class="mt-6 text-xs font-bold uppercase tracking-widest" style="color:var(--muted)">{l.kicker} · {a.k2}</p>
    <h1 class="mt-2 text-4xl font-extrabold sm:text-6xl">{a.title}</h1>
    <p class="mt-3 font-display text-2xl font-bold" style="color:var(--caid)">{a.h2}</p>
    <p class="mt-4 max-w-3xl text-lg" style="color:var(--muted)">{a.lead}</p>

    <LogisticsMap lang={lang} mode="aid" />

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {D.aid.map((s, i) => {
        const it = a.items[s.id as 'A1'];
        return (
          <article data-reveal class:list={['card-hover flex flex-col gap-3 rounded-[2rem] p-6', i === 3 ? 'neo' : 'glass']}>
            <div class="flex items-start justify-between gap-3">
              <div class="font-display text-5xl font-extrabold leading-none" style="color:var(--caid)">{s.id === 'M' ? l.words.finish : s.id}</div>
              <button type="button" data-aid-focus={s.id} class="btn btn-ghost !min-h-10 !px-4 !py-2 text-sm">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>{a.focus}
              </button>
            </div>
            <h2 class="font-display text-xl font-bold">{s.name.replace(/^Meta · /, '')}</h2>
            <div class="flex flex-wrap gap-1.5">
              {Object.entries(s.km).map(([r, k]) => <span class="rounded-lg border px-2 py-0.5 text-xs font-bold tabular-nums" style={`border-color:${COL[r]};color:${COL[r]}`}>{l.races[r as Id]} · km {dec(k as number)}</span>)}
            </div>
            <p><strong>{a.content}:</strong> {it.what}</p>
            <p class="text-sm" style="color:var(--muted)">{it.why}</p>
            <p class="rounded-2xl p-3 text-sm font-semibold" style="background:color-mix(in srgb,var(--c10) 12%,transparent)"><span class="pill pill-soon mr-1.5">{l.words.proposal}</span>{it.theme}</p>
            <p class="mt-auto text-xs tabular-nums" style="color:var(--muted)">{s.lat.toFixed(5)}, {s.lon.toFixed(5)} · <a href={gm(s.lat, s.lon)} target="_blank" rel="noopener" class="font-bold underline underline-offset-2" style="color:var(--accent)">{l.words.maps}</a></p>
          </article>
        );
      })}
    </div>

    <aside data-reveal class="neo mt-12 p-6 sm:p-8">
      <h2 class="text-2xl font-extrabold">{a.susTitle}</h2>
      <ul class="mt-4 grid max-w-4xl gap-3">
        {a.sus.map((n) => <li class="flex gap-3" style="color:var(--muted)"><span class="mt-2 h-2 w-2 shrink-0 rounded-full" style="background:var(--green)" aria-hidden="true"></span><span>{n}</span></li>)}
      </ul>
    </aside>

    <section id="calc" class="mt-20 scroll-mt-28">
      <h2 data-reveal class="text-3xl font-extrabold sm:text-4xl">{a.calc.title}</h2>
      <p data-reveal class="mt-3 max-w-3xl" style="color:var(--muted)">{a.calc.lead}</p>
      <div data-reveal class="glass mt-6 grid gap-5 rounded-[2rem] p-6 md:grid-cols-[1fr_auto] md:items-center">
        <div class="grid gap-4">
          {(['21k', '10k', 'cam'] as const).map((id) => (
            <label class="grid grid-cols-[7.5rem_1fr_3.5rem] items-center gap-3 text-sm font-bold">
              <span class="flex items-center gap-2"><i class="rdot" style={`background:${COL[id]}`}></i>{l.races[id]}</span>
              <input type="range" data-n={id} min="0" max="800" step="10" value={defaults[id]} class="w-full" style={`accent-color:${COL[id]}`} />
              <span data-nv={id} class="font-display text-right text-xl font-extrabold tabular-nums">{defaults[id]}</span>
            </label>
          ))}
        </div>
        <div class="clay px-8 py-5 text-center"><div id="calc-total" class="font-display text-5xl font-extrabold tabular-nums">800</div><div class="text-sm font-semibold">{a.calc.runners}</div></div>
      </div>
      <div data-reveal class="glass mt-4 overflow-x-auto rounded-[1.75rem] p-2">
        <table class="w-full min-w-[44rem] text-right text-sm">
          <thead><tr style="color:var(--muted)"><th scope="col" class="p-3 text-left">{a.calc.cols.point}</th>{cols.map((k) => <th scope="col" class="p-3">{a.calc.cols[k]}</th>)}</tr></thead>
          <tbody>
            {D.aid.map((s) => (
              <tr class="border-t" style="border-color:var(--line)"><th scope="row" class="p-3 text-left font-display text-base font-extrabold" style="color:var(--caid)">{s.id === 'M' ? l.words.finish : s.id}</th>{cols.map((k) => <td class="p-3 font-semibold tabular-nums" data-c={`${s.id}-${k}`}>–</td>)}</tr>
            ))}
            <tr class="border-t-2" style="border-color:var(--fg)"><th scope="row" class="p-3 text-left font-display text-base font-extrabold">{a.calc.total}</th>{cols.map((k) => <td class="p-3 font-display text-base font-extrabold tabular-nums" data-c={`T-${k}`}>–</td>)}</tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 max-w-4xl text-sm" style="color:var(--muted)">{a.calc.note}</p>
    </section>

    <section class="mt-20">
      <h2 data-reveal class="text-3xl font-extrabold sm:text-4xl">{a.ideasTitle}</h2>
      <p data-reveal class="mt-3 max-w-3xl" style="color:var(--muted)">{a.ideasLead}</p>
      <ol class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {a.ideas.map((it, i) => (
          <li data-reveal class:list={['card-hover rounded-[1.75rem] p-5', i % 3 === 1 ? 'neo' : 'glass']}>
            <span class="clay grid h-11 w-11 place-items-center" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={icons[i]}/></svg></span>
            <h3 class="font-display mt-4 text-xl font-bold">{it.t}</h3><p class="mt-1" style="color:var(--muted)">{it.d}</p>
          </li>
        ))}
      </ol>
    </section>
    <a href={`/${lang}/closures/`} class="btn btn-primary mt-12">{a.toClosures} <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</Base>
