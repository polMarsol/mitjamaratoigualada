---
import { LANGS, useT, type Lang } from '../../i18n';
import { LEGAL_DOCS } from '../../i18n/legal';
import { LEGAL } from '../../data/event';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export const getStaticPaths = () =>
  LANGS.flatMap((lang) => (['legal', 'privacy', 'cookies'] as const).map((page) => ({ params: { lang, page } })));
const { lang, page } = Astro.params as { lang: Lang; page: 'legal' | 'privacy' | 'cookies' };
const doc = LEGAL_DOCS[lang][page];
const t = useT(lang);
const site = Astro.site!.href.replace(/\/$/, '');
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.breadcrumb.home, item: `${site}/${lang}/` },
    { '@type': 'ListItem', position: 2, name: doc.title, item: `${site}/${lang}/${page}/` },
  ],
}];
---
<Base lang={lang} path={`${page}/`} title={`${doc.title} · MM Igualada`} description={doc.desc} jsonld={jsonld}>
  <article class="mx-auto max-w-3xl px-5 pb-10 pt-32 sm:px-8 md:pt-40">
    <Breadcrumb lang={lang} current={doc.title} />
    <h1 class="mt-6 text-4xl font-extrabold sm:text-6xl">{doc.title}</h1>
    <p class="mt-3 text-sm" style="color:var(--muted)">{doc.updated}: {LEGAL.updated}</p>
    <div class="mt-10 grid gap-8">
      {doc.sections.map((s) => (
        <section>
          <h2 class="text-2xl font-bold">{s.h}</h2>
          {s.p.map((p) => <p class="mt-3 leading-relaxed" style="color:var(--muted)">{p}</p>)}
        </section>
      ))}
    </div>
    <a href={`/${lang}/`} class="btn btn-ghost mt-12">← {t.notFound.back}</a>
  </article>
</Base>
