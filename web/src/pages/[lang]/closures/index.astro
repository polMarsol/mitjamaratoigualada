---
import { LANGS, useT, type Lang } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LogisticsMap from '../../../components/LogisticsMap.astro';
import D from '../../../data/logistics.json';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang), l = t.logistics, c = l.closures;
const site = Astro.site!.href.replace(/\/$/, '');
const jsonld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: t.breadcrumb.home, item: `${site}/${lang}/` },
  { '@type': 'ListItem', position: 2, name: c.title, item: `${site}/${lang}/closures/` }] }];
type Id = '21k' | '10k' | 'cam';
const ids = ['21k', '10k', 'cam'] as const;
const COL: Record<string, string> = { '21k': 'var(--c21)', '10k': 'var(--c10)', cam: 'var(--ccam)' };
const dec = (v: number, d = 1) => v.toFixed(d).replace('.', lang === 'en' ? '.' : ',');
const gm = (a: number[]) => `https://www.google.com/maps/search/?api=1&query=${a[0]},${a[1]}`;
const what = (s: string) => s.replaceAll('Giro:', `${l.words.turn}:`).replaceAll('Cruce:', `${l.words.cross}:`);
// tram(s) de cada carrer únic, per ressaltar-lo al mapa
const segs = (name: string) => D.races.flatMap((r) => r.rows.filter((x) => x.n === name).map((x) => `${r.id},${x.k0},${x.k1}`)).join('|');
const totVol = D.vol.reduce((s, v) => s + v.n, 0), police = D.vol.filter((v) => v.kind === 'policia').length;
const stats = [[D.vol.length, c.stats.points, ''], [totVol, c.stats.vols, ''], [police, c.stats.police, ''], [D.aid.length * 3, c.stats.aid, '+']] as const;
const icons = ['M4 12h16M12 4v16', 'M4 4h16v16H4zM9 9h6v6H9z', 'M12 3a9 9 0 1 0 9 9M12 7v5l3 2', 'M3 12h4l3-8 4 16 3-8h4'];
---
<Base lang={lang} path="closures/" title={`${c.title} · MM Igualada`} description={c.metaDesc} jsonld={jsonld}>
  <div class="mx-auto max-w-6xl px-5 pb-10 pt-32 sm:px-8 md:pt-40">
    <Breadcrumb lang={lang} current={c.title} />
    <p class="mt-6 text-xs font-bold uppercase tracking-widest" style="color:var(--muted)">{l.kicker}</p>
    <h1 class="mt-2 text-4xl font-extrabold sm:text-6xl">{c.h1}</h1>
    <p class="mt-4 max-w-3xl text-lg" style="color:var(--muted)">{c.lead}</p>
    <div class="mt-6 flex flex-wrap gap-2.5">
      {D.races.map((r) => (
        <span class="glass flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold"><i class="rdot" style={`background:${COL[r.id]}`}></i>{l.raceNames[r.id as Id]}<span class="font-medium tabular-nums" style="color:var(--muted)">{dec(r.km)} km</span></span>
      ))}
    </div>

    <LogisticsMap lang={lang} mode="closures">
      <div id="sim" data-sim="off" class="mx-1 mt-3 rounded-[1.5rem] p-4 sm:p-5" style="background:color-mix(in srgb,var(--bg) 70%,transparent)">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
          <div class="min-w-0 flex-1 basis-64">
            <h2 class="font-display text-xl font-extrabold">{c.sim.title}</h2>
            <p class="mt-1 text-sm" style="color:var(--muted)">{c.sim.lead}</p>
          </div>
          <label class="flex min-h-11 cursor-pointer items-center gap-2 text-sm font-bold"><input id="sim-on" type="checkbox" class="h-5 w-5 accent-[var(--accent)]" />{c.sim.on}</label>
          <button id="sim-play" type="button" aria-pressed="false" class="btn btn-primary !min-h-11 !px-5 !py-2 text-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4l14 8-14 8z"/></svg><span>{c.sim.play}</span>
          </button>
        </div>
        <div class="mt-4 flex items-center gap-4">
          <output id="sim-time" for="sim-range" class="font-display w-[4.6ch] shrink-0 text-3xl font-extrabold tabular-nums">09:00</output>
          <input id="sim-range" type="range" min="480" max="720" step="5" value="540" aria-label={c.sim.title} class="sim-range w-full" />
          <p class="sim-now shrink-0 text-right text-sm font-semibold leading-tight" style="color:var(--muted)"><span id="sim-count" class="font-display block text-2xl font-extrabold tabular-nums" style="color:var(--cpol)">0</span>{c.sim.now}</p>
        </div>
        <div class="mt-1 flex justify-between pl-[calc(4.6ch+1rem)] text-xs tabular-nums sm:pr-28" style="color:var(--muted)" aria-hidden="true"><span>08:00</span><span>09:00</span><span>10:00</span><span>11:00</span><span>12:00</span></div>
      </div>
    </LogisticsMap>

    <section id="streets" data-sim="off" class="mt-16 scroll-mt-28">
      <p data-reveal class="text-xs font-bold uppercase tracking-widest" style="color:var(--muted)">{c.k1}</p>
      <h2 data-reveal class="mt-1 text-3xl font-extrabold sm:text-4xl">{c.h2}</h2>
      <p data-reveal class="mt-3 max-w-3xl" style="color:var(--muted)">{c.rule}</p>
      <div data-reveal class="mt-6 flex flex-wrap items-end gap-3">
        <div role="tablist" data-tabs="streets" aria-label={c.h2} class="glass inline-flex flex-wrap rounded-[1.6rem] p-1.5">
          {ids.map((id, i) => <button type="button" role="tab" data-tab={id} aria-selected={i === 0 ? 'true' : 'false'} class="ltab rounded-full px-4 py-2.5 text-sm font-bold sm:px-5">{l.races[id]}</button>)}
          <button type="button" role="tab" data-tab="all" aria-selected="false" class="ltab rounded-full px-4 py-2.5 text-sm font-bold sm:px-5">{c.all}</button>
        </div>
        <label class="ml-auto grid gap-1 text-sm font-bold"><span>{c.search}</span>
          <input id="street-q" type="search" class="field min-h-[48px] rounded-2xl px-4" placeholder="Av. de la Pietat…" />
        </label>
      </div>
      <p class="mt-3 text-sm" style="color:var(--muted)"><span id="street-count">{D.races[0].rows.length}</span> {c.count}</p>

      {D.races.map((r, ri) => (
        <div data-panel={r.id} hidden={ri !== 0} class="glass mt-3 overflow-x-auto rounded-[1.75rem] p-2">
          <table class="w-full min-w-[36rem] text-left text-sm">
            <thead><tr style="color:var(--muted)"><th scope="col" class="p-3">{c.cols.km}</th><th scope="col" class="p-3">{c.cols.street}</th><th scope="col" class="p-3">{c.cols.close}</th><th scope="col" class="p-3">{c.cols.reopen}</th><th scope="col" class="st p-3">{c.cols.status}</th><th scope="col" class="p-3">{c.cols.map}</th></tr></thead>
            <tbody>
              {r.rows.map((x) => (
                <tr class="lrow border-t" style="border-color:var(--line)" tabindex="0" data-ll={x.a.join(',')} data-seg={`${r.id},${x.k0},${x.k1}`} data-tc={x.tc} data-tr={x.tr} data-title={x.n} data-sub={`${l.races[r.id as Id]} · km ${dec(x.k0)}–${dec(x.k1)} · ${x.tc}–${x.tr}`}>
                  <td class="whitespace-nowrap p-3 tabular-nums" style="color:var(--muted)">{dec(x.k0)}–{dec(x.k1)}</td>
                  <td class="p-3 font-semibold">{x.n}</td>
                  <td class="p-3 font-display font-bold tabular-nums">{x.tc}</td><td class="p-3 font-display font-bold tabular-nums">{x.tr}</td>
                  <td class="st p-3"><span class="pill pill-open">{c.sim.open}</span></td>
                  <td class="p-3"><a href={gm(x.a)} target="_blank" rel="noopener" class="font-bold underline underline-offset-2" style="color:var(--accent)">{l.words.see}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
      <div data-panel="all" hidden class="glass mt-3 overflow-x-auto rounded-[1.75rem] p-2">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead><tr style="color:var(--muted)"><th scope="col" class="p-3">{c.cols.street}</th><th scope="col" class="p-3">{c.cols.races}</th><th scope="col" class="p-3">{c.cols.close}</th><th scope="col" class="p-3">{c.cols.reopen}</th><th scope="col" class="st p-3">{c.cols.status}</th><th scope="col" class="p-3">{c.cols.map}</th></tr></thead>
          <tbody>
            {D.streets.map((s) => (
              <tr class="lrow border-t" style="border-color:var(--line)" tabindex="0" data-ll={s.a.join(',')} data-seg={segs(s.n)} data-tc={s.tc} data-tr={s.tr} data-title={s.n} data-sub={`${s.races.map((r) => l.races[r as Id]).join(' · ')} · ${s.tc}–${s.tr}`}>
                <td class="p-3 font-semibold">{s.n}</td>
                <td class="p-3"><span class="flex gap-1">{ids.filter((r) => s.races.includes(r)).map((r) => <i class="rdot" title={l.races[r]} style={`background:${COL[r]}`}></i>)}</span></td>
                <td class="p-3 font-display font-bold tabular-nums">{s.tc}</td><td class="p-3 font-display font-bold tabular-nums">{s.tr}</td>
                <td class="st p-3"><span class="pill pill-open">{c.sim.open}</span></td>
                <td class="p-3"><a href={gm(s.a)} target="_blank" rel="noopener" class="font-bold underline underline-offset-2" style="color:var(--accent)">{l.words.see}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p id="street-empty" hidden class="p-6 text-center" style="color:var(--muted)">{c.empty}</p>
    </section>

    <section id="vols" class="mt-20 scroll-mt-28">
      <p data-reveal class="text-xs font-bold uppercase tracking-widest" style="color:var(--muted)">{c.k3}</p>
      <h2 data-reveal class="mt-1 text-3xl font-extrabold sm:text-4xl">{c.volH2}</h2>
      <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {stats.map(([n, label, pre], i) => (
          <div data-reveal class:list={['card-hover p-5', i === 3 ? 'clay' : 'neo']}>
            <div class="font-display text-5xl font-extrabold tabular-nums" data-count-to={n} data-prefix={pre} style={i === 2 ? 'color:var(--cpol)' : i < 2 ? 'color:var(--accent)' : ''}>{pre}{n}</div>
            <div class="mt-1 text-sm font-semibold" style={i === 3 ? '' : 'color:var(--muted)'}>{label}</div>
          </div>
        ))}
      </div>
      <p data-reveal class="mt-6 max-w-3xl" style="color:var(--muted)">{c.volLead}</p>
      <div data-reveal role="tablist" data-tabs="vols" aria-label={c.volH2} class="glass mt-6 inline-flex flex-wrap rounded-[1.6rem] p-1.5">
        <button type="button" role="tab" data-tab="all" aria-selected="true" class="ltab rounded-full px-4 py-2.5 text-sm font-bold sm:px-5">{c.volAll}</button>
        {ids.map((id) => <button type="button" role="tab" data-tab={id} aria-selected="false" class="ltab rounded-full px-4 py-2.5 text-sm font-bold sm:px-5">{l.races[id]}</button>)}
      </div>
      <div class="glass mt-3 overflow-x-auto rounded-[1.75rem] p-2">
        <table class="w-full min-w-[44rem] text-left text-sm">
          <thead><tr style="color:var(--muted)"><th scope="col" class="p-3">{c.volCols.id}</th><th scope="col" class="p-3">{c.volCols.place}</th><th scope="col" class="p-3">{c.volCols.kind}</th><th scope="col" class="p-3">{c.volCols.races}</th><th scope="col" class="p-3">{c.volCols.people}</th><th scope="col" class="p-3">{c.volCols.map}</th></tr></thead>
          <tbody>
            {D.vol.map((v) => (
              <tr class="lrow border-t" style="border-color:var(--line)" tabindex="0" data-races={v.races.join(',')} data-ll={`${v.lat},${v.lon}`} data-title={`#${v.id} · ${l.kinds[v.kind as 'gir']}`} data-sub={`${what(v.what)} · ${v.n} ${l.words.people}`}>
                <td class="p-3 font-display text-base font-extrabold tabular-nums">{v.id}</td>
                <td class="p-3 font-semibold">{what(v.what)}</td>
                <td class="p-3"><span class={`pill pill-${v.kind}`}>{l.kinds[v.kind as 'gir']}</span></td>
                <td class="whitespace-nowrap p-3 tabular-nums">{Object.entries(v.km).map(([r, k], i) => <>{i > 0 && ' · '}<span style={`color:${COL[r]};font-weight:700`}>{l.races[r as Id].replace(/^(Mitja|Half) /, '')} {dec(k as number)}</span></>)}</td>
                <td class="p-3 font-display font-bold tabular-nums">{v.n}</td>
                <td class="p-3"><a href={gm([v.lat, v.lon])} target="_blank" rel="noopener" class="font-bold underline underline-offset-2" style="color:var(--accent)">{l.words.see}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-20">
      <h2 data-reveal class="text-3xl font-extrabold sm:text-4xl">{c.extraTitle}</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-2">
        {c.extra.map((it, i) => (
          <li data-reveal class:list={['card-hover flex gap-4 rounded-[1.75rem] p-5', i % 3 === 1 ? 'neo' : 'glass']}>
            <span class="clay grid h-11 w-11 shrink-0 place-items-center" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d={icons[i]}/></svg></span>
            <div><h3 class="font-display text-xl font-bold">{it.t} <span class="pill pill-soon align-middle">{l.words.proposal}</span></h3><p class="mt-1" style="color:var(--muted)">{it.d}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <aside data-reveal class="neo mt-16 p-6 sm:p-8">
      <h2 class="text-2xl font-extrabold">{c.notesTitle}</h2>
      <ul class="mt-4 grid max-w-4xl gap-3">
        {c.notes.map((n) => <li class="flex gap-3" style="color:var(--muted)"><span class="mt-2 h-2 w-2 shrink-0 rounded-full" style="background:var(--accent)" aria-hidden="true"></span><span>{n}</span></li>)}
      </ul>
    </aside>
    <a href={`/${lang}/aid-stations/`} class="btn btn-primary mt-10">{c.toAid} <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</Base>
<style>
  .sim-range { -webkit-appearance: none; appearance: none; height: 12px; border-radius: 999px; cursor: pointer; background: linear-gradient(90deg, var(--cpol) var(--p, 25%), var(--line) var(--p, 25%)); }
  .sim-range::-webkit-slider-thumb { -webkit-appearance: none; width: 28px; height: 28px; border-radius: 50%; background: var(--bg); border: 4px solid var(--cpol); box-shadow: 0 4px 10px rgb(0 0 0 / .3); transition: transform .18s var(--ease-out-strong); }
  .sim-range::-moz-range-thumb { width: 22px; height: 22px; border-radius: 50%; background: var(--bg); border: 4px solid var(--cpol); box-shadow: 0 4px 10px rgb(0 0 0 / .3); }
  .sim-range:active::-webkit-slider-thumb { transform: scale(1.15); }
  #sim[data-sim='off'] .sim-range { background: var(--line); }
  #sim[data-sim='off'] .sim-now { opacity: .4; }
</style>
