---
import { LANGS, useT, type Lang } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { RESULTS, CATS, fmtTime, fmtPace } from '../../../data/results';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang), r = t.results;
const site = Astro.site!.href.replace(/\/$/, '');
const jsonld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: t.breadcrumb.home, item: `${site}/${lang}/` },
  { '@type': 'ListItem', position: 2, name: r.title, item: `${site}/${lang}/results/` }] }];
const mods = ['21k', '10k'] as const;
---
<Base lang={lang} path="results/" title={`${r.title} · MM Igualada`} description={r.metaDesc} jsonld={jsonld}>
  <div class="mx-auto max-w-6xl px-5 pb-10 pt-32 sm:px-8 md:pt-40">
    <Breadcrumb lang={lang} current={r.title} />
    <h1 class="mt-6 text-4xl font-extrabold sm:text-6xl">{r.title}</h1>
    <p class="mt-4 max-w-2xl text-lg" style="color:var(--muted)">{r.lead}</p>
    <p class="clay mt-6 inline-block px-4 py-2 text-sm font-bold" role="note">{r.sample}</p>

    <div role="tablist" aria-label={r.title} class="glass mt-10 inline-flex rounded-full p-1.5">
      {mods.map((m, i) => <button type="button" role="tab" data-mod={m} aria-selected={i === 0 ? 'true' : 'false'} class="rtab rounded-full px-5 py-2.5 text-sm font-bold">{r.tabs[m]}</button>)}
    </div>

    {mods.map((m, mi) => {
      const rows = RESULTS[m].rows, km = RESULTS[m].km;
      const top = (sex: 'M' | 'F') => rows.filter((x) => x.sex === sex).slice(0, 3);
      return (
        <section data-panel={m} hidden={mi !== 0} class="mt-8">
          <h2 class="text-2xl font-extrabold">{r.podium}</h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            {(['M', 'F'] as const).map((sx) => (
              <div class="glass rounded-[1.75rem] p-5">
                <div class="mb-3 text-sm font-bold uppercase tracking-wider" style="color:var(--muted)">{r.sexes[sx]}</div>
                <ol class="grid gap-2">
                  {top(sx).map((x, i) => (
                    <li class:list={['flex items-center gap-3 rounded-2xl p-3', i === 0 ? 'clay' : 'neo !rounded-2xl']}>
                      <span class="font-display grid h-9 w-9 place-items-center rounded-full text-lg font-extrabold" style="background:rgb(255 255 255/.25)">{i + 1}</span>
                      <span class="flex-1 font-bold leading-tight">{x.name}<span class="block text-xs font-medium opacity-75">{x.cat} · #{x.bib}</span></span>
                      <span class="font-display text-lg font-extrabold tabular-nums">{fmtTime(x.sec)}</span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>

          <div class="mt-8 flex flex-wrap items-end gap-3" data-filters>
            <label class="grid gap-1 text-sm font-bold"><span>{r.search}</span>
              <input type="search" data-q class="field min-h-[48px] rounded-2xl px-4" placeholder={r.search} />
            </label>
            <label class="grid gap-1 text-sm font-bold"><span>{r.sex}</span>
              <select data-sex class="field min-h-[48px] rounded-2xl px-4"><option value="">{r.allM}</option><option value="M">{r.sexes.M}</option><option value="F">{r.sexes.F}</option></select>
            </label>
            <label class="grid gap-1 text-sm font-bold"><span>{r.category}</span>
              <select data-cat class="field min-h-[48px] rounded-2xl px-4"><option value="">{r.all}</option>{CATS.map((c) => <option>{c}</option>)}</select>
            </label>
            <button type="button" data-csv class="btn btn-ghost ml-auto">{r.csv}</button>
          </div>
          <p class="mt-3 text-sm" style="color:var(--muted)"><span data-count>{rows.length}</span> {r.count}</p>

          <div class="glass mt-3 overflow-x-auto rounded-[1.75rem] p-2">
            <table class="w-full min-w-[36rem] text-left text-sm">
              <thead><tr style="color:var(--muted)">
                <th scope="col" class="p-3">{r.cols.pos}</th><th scope="col" class="p-3">{r.cols.bib}</th><th scope="col" class="p-3">{r.cols.name}</th><th scope="col" class="p-3">{r.cols.cat}</th><th scope="col" class="p-3">{r.cols.time}</th><th scope="col" class="p-3">{r.cols.pace} ({r.pace})</th>
              </tr></thead>
              <tbody>
                {rows.map((x) => (
                  <tr class="border-t transition-colors hover:bg-[var(--line)]" style="border-color:var(--line)" data-row data-name={x.name.toLowerCase()} data-bib={x.bib} data-sex={x.sex} data-cat={x.cat}>
                    <td class="p-3 font-display text-base font-extrabold">{x.pos}</td><td class="p-3 tabular-nums">{x.bib}</td>
                    <td class="p-3 font-semibold">{x.name}</td><td class="p-3">{x.cat} · {x.sex}</td>
                    <td class="p-3 font-display font-bold tabular-nums">{fmtTime(x.sec)}</td><td class="p-3 tabular-nums">{fmtPace(x.sec, km)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p data-empty hidden class="p-6 text-center" style="color:var(--muted)">{r.empty}</p>
          </div>
        </section>
      );
    })}
    <p class="mt-4 text-sm" style="color:var(--muted)">{r.walkNote}</p>

    <div class="neo mt-12 p-8">
      <h2 class="text-2xl font-extrabold">{r.liveTitle}</h2>
      <p class="mt-2 max-w-xl" style="color:var(--muted)">{r.live}</p>
      <a href={`/${lang}/gallery/`} class="btn btn-ghost mt-5">{t.nav.gallery} →</a>
    </div>
  </div>
</Base>
<style>
  .rtab { transition: background-color .2s, color .2s, transform .18s var(--ease-out-strong); }
  .rtab:active { transform: scale(.97); }
  .rtab[aria-selected='true'] { background: var(--grad); color: var(--accent-fg); box-shadow: inset 0 -3px 5px rgb(0 0 0 / .2), inset 0 3px 5px rgb(255 255 255 / .3); }
  .field { background: var(--bg); border: 1.5px solid var(--line); color: var(--fg); }
  .field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent); }
</style>
<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-mod]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  tabs.forEach((tb) => tb.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === tb)));
    panels.forEach((p) => (p.hidden = p.dataset.panel !== tb.dataset.mod));
  }));
  panels.forEach((p) => {
    const q = p.querySelector<HTMLInputElement>('[data-q]')!, sx = p.querySelector<HTMLSelectElement>('[data-sex]')!, ct = p.querySelector<HTMLSelectElement>('[data-cat]')!;
    const rows = [...p.querySelectorAll<HTMLElement>('[data-row]')];
    const apply = () => {
      const s = q.value.trim().toLowerCase(); let n = 0;
      rows.forEach((r) => {
        const ok = (!s || r.dataset.name!.includes(s) || r.dataset.bib === s) && (!sx.value || r.dataset.sex === sx.value) && (!ct.value || r.dataset.cat === ct.value);
        r.hidden = !ok; if (ok) n++;
      });
      p.querySelector('[data-count]')!.textContent = String(n);
      p.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
    };
    [q, sx, ct].forEach((el) => el.addEventListener('input', apply));
    p.querySelector('[data-csv]')!.addEventListener('click', () => {
      const lines = rows.filter((r) => !r.hidden).map((r) => [...r.children].map((c) => `"${(c.textContent || '').trim()}"`).join(','));
      const head = [...p.querySelectorAll('thead th')].map((h) => `"${h.textContent}"`).join(',');
      const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob(['﻿' + [head, ...lines].join('\n')], { type: 'text/csv' }));
      a.download = `mm-igualada-${p.dataset.panel}.csv`; a.click(); URL.revokeObjectURL(a.href);
    });
  });
</script>
