---
import { useT, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const icons = [
  '<path d="M8 3 3 7l3 3 2-1v12h8V9l2 1 3-3-5-4a4 4 0 0 1-8 0Z"/>',
  '<rect x="4" y="6" width="16" height="12" rx="2"/><path d="M8 10h8M8 14h5"/>',
  '<path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  '<rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8v13M3 13h18M12 8c-2-4-6-4-5-1s5 1 5 1Zm0 0c2-4 6-4 5-1s-5 1-5 1Z"/>',
  '<circle cx="12" cy="9" r="6"/><path d="m8.500 14-2 7 5.500-3 5.500 3-2-7"/>',
  '<path d="M12 3c3 4 6 6 6 10a6 6 0 0 1-12 0c0-4 3-6 6-10Z"/>',
];
const funIcons = [
  '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.500"/><path d="M12 3v3M12 18v3"/>',
  '<path d="M4 11h16a8 8 0 0 1-16 0ZM8 7c0-2 2-2 2-4M13 7c0-2 2-2 2-4"/>',
  '<path d="M3 21V9l9-6 9 6v12M9 21v-7h6v7"/>',
  '<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
  '<path d="M6 21V8a6 6 0 0 1 12 0v13M6 14h12"/><path d="M12 2v3"/>',
  '<path d="M4 20c0-6 3-9 8-9s8 3 8 9M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/>',
];
---
<section id="bossa" class="px-5 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-center gap-12 lg:grid-cols-[.9fr_1.1fr]">
      <!-- Il·lustració de la bossa amb la samarreta -->
      <div data-reveal class="relative mx-auto w-full max-w-sm">
        <div class="bag-stage relative aspect-[4/5] rounded-[2.5rem]" style="background:var(--grad)">
          <svg viewBox="0 0 320 400" class="absolute inset-0 h-full w-full drop-shadow-2xl" role="img" aria-label={t.bag.title}>
            <g class="bag-float">
              <path d="M95 150c0-45 22-70 65-70s65 25 65 70" fill="none" stroke="#ffffff" stroke-opacity=".85" stroke-width="10" stroke-linecap="round"/>
              <path d="M70 140h180l14 220a14 14 0 0 1-14 15H70a14 14 0 0 1-14-15L70 140Z" fill="#ffffff" fill-opacity=".94"/>
              <path d="M70 140h180l3 40H67l3-40Z" fill="#0d2233" fill-opacity=".08"/>
              <text x="160" y="255" text-anchor="middle" font-family="Bricolage Grotesque Variable, sans-serif" font-weight="800" font-size="58" fill="#0b5cad">MM</text>
              <text x="160" y="292" text-anchor="middle" font-family="Instrument Sans Variable, sans-serif" font-weight="700" font-size="17" letter-spacing="3" fill="#1a7a50">IGUALADA</text>
              <text x="160" y="322" text-anchor="middle" font-family="Instrument Sans Variable, sans-serif" font-weight="600" font-size="13" fill="#45606f">2026 · 1A EDICIÓ</text>
              <!-- samarreta que sobresurt -->
              <path d="m120 132 22-22h36l22 22-14 34h-8v-16h-36v16h-8Z" fill="#0d2233" fill-opacity=".92"/>
              <path d="M142 110c4 10 32 10 36 0" fill="none" stroke="#ffffff" stroke-opacity=".7" stroke-width="3"/>
            </g>
          </svg>
          <span class="clay absolute -right-3 top-6 px-4 py-2 text-sm font-extrabold sm:-right-6">{t.bag.kicker}</span>
        </div>
      </div>

      <div>
        <p data-reveal class="text-sm font-bold uppercase tracking-wider" style="color:var(--accent)">{t.bag.kicker}</p>
        <h2 data-reveal class="mt-2 text-4xl font-extrabold sm:text-6xl">{t.bag.title}</h2>
        <p data-reveal class="mt-4 text-lg" style="color:var(--muted)">{t.bag.lead}</p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {t.bag.items.map((it, i) => (
            <li data-reveal class="glass card-hover flex gap-3 rounded-2xl p-4">
              <span class="clay grid h-10 w-10 shrink-0 place-items-center" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
              </span>
              <div><h3 class="font-display font-bold leading-tight">{it.t}</h3><p class="mt-0.5 text-sm" style="color:var(--muted)">{it.d}</p></div>
            </li>
          ))}
        </ul>
        <p data-reveal class="mt-4 text-xs" style="color:var(--muted)">{t.bag.note}</p>
        <div data-reveal class="mt-6 flex flex-wrap gap-3">
          <a href={`/${lang}/#inscripcions`} class="btn btn-primary">{t.bag.cta} <span class="arrow" aria-hidden="true">→</span></a>
          <a href={`/${lang}/shirt/`} class="btn btn-ghost">{t.shirt.see} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>

    <div id="animacio" class="mt-28">
      <h2 data-reveal class="text-4xl font-extrabold sm:text-6xl">{t.fun.title}</h2>
      <p data-reveal class="mt-4 max-w-2xl text-lg" style="color:var(--muted)">{t.fun.lead}</p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {t.fun.items.map((it, i) => (
          <article data-reveal class:list={['fun-card card-hover relative overflow-hidden rounded-[1.75rem] p-6', i % 3 === 1 ? 'neo' : 'glass']}>
            <span class="clay mb-4 grid h-12 w-12 place-items-center" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={funIcons[i]} />
            </span>
            <h3 class="font-display text-xl font-bold">{it.t}</h3>
            <p class="mt-2" style="color:var(--muted)">{it.d}</p>
          </article>
        ))}
      </div>
      <p data-reveal class="mt-4 text-xs" style="color:var(--muted)">{t.fun.note}</p>
    </div>
  </div>
</section>
<style>
  .bag-float { animation: bagfloat 6s ease-in-out infinite; transform-origin: 50% 60%; }
  @keyframes bagfloat { 50% { transform: translateY(-8px) rotate(1.2deg); } }
  @media (prefers-reduced-motion: reduce) { .bag-float { animation: none; } }
</style>
