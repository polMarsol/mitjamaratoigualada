---
import { useT, type Lang } from '../i18n';
import { MODALITIES } from '../data/event';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const r = t.routes;
---
<section id="recorreguts" class="px-5 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <h2 data-reveal class="text-4xl font-extrabold sm:text-6xl">{r.title}</h2>
    <p data-reveal class="mt-4 max-w-2xl text-lg" style="color:var(--muted)">{r.lead}</p>

    <div data-reveal role="tablist" aria-label={r.title} class="glass mt-10 inline-flex rounded-full p-1.5">
      {MODALITIES.map((m, i) => (
        <button type="button" role="tab" id={`tab-${m.id}`} data-route={m.routeId} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="route-panel"
                class="tab rounded-full px-4 py-2.5 text-sm font-bold sm:px-6">{r.tabs[m.id]}</button>
      ))}
    </div>

    <div id="route-panel" role="tabpanel" data-reveal class="mt-6 grid gap-5 lg:grid-cols-[1fr_280px]"
         data-i18n={JSON.stringify({ expand: r.expand, collapse: r.collapse, start: r.start, grade: r.grade, altitude: r.altitude })}>
      <div id="route-wrap" class="glass relative overflow-hidden rounded-[2rem] p-2 lg:row-span-1">
        <div id="route-map" class="h-[52vh] min-h-[320px] w-full overflow-hidden rounded-[1.5rem]" role="application" aria-label={r.mapAlt}></div>
        <button id="map-expand" type="button" class="btn btn-ghost !min-h-10 !px-4 !py-2 absolute right-5 top-5 z-[500] text-sm" style="background:var(--bg)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          <span id="map-expand-label">{r.expand}</span>
        </button>

        <!-- perfil d'elevació dins del mateix panell (així també es veu en pantalla completa) -->
        <div class="px-3 pb-2 pt-4">
          <div class="mb-1 flex items-baseline justify-between text-sm">
            <span class="font-bold">{r.profile}</span>
            <span id="hover-info" class="tabular-nums" style="color:var(--muted)">&nbsp;</span>
          </div>
          <div id="profile" class="relative h-44 w-full touch-none select-none sm:h-52" role="img" aria-label={r.profile}></div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 lg:grid-cols-1 lg:content-start">
        <div class="neo p-5"><div class="text-sm" style="color:var(--muted)">{r.distance}</div><div class="font-display text-4xl font-extrabold"><span id="st-dist">–</span> <span class="text-lg">km</span></div></div>
        <div class="neo p-5"><div class="text-sm" style="color:var(--muted)">{r.gain}</div><div class="font-display text-4xl font-extrabold" style="color:var(--accent)">+<span id="st-gain">–</span> <span class="text-lg">m</span></div></div>
        <div class="neo p-5"><div class="text-sm" style="color:var(--muted)">{r.loss}</div><div class="font-display text-4xl font-extrabold" style="color:var(--green)">−<span id="st-loss">–</span> <span class="text-lg">m</span></div></div>
        <div class="neo p-5"><div class="text-sm" style="color:var(--muted)">{r.altitude}</div><div class="font-display text-3xl font-extrabold"><span id="st-alt">–</span> <span class="text-lg">m</span></div></div>
        <a id="gpx-dl" href="/gpx/21k.gpx" download class="btn btn-primary col-span-2 lg:col-span-1">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 21h16"/></svg>{r.download}
        </a>
      </div>
    </div>
    <p data-reveal class="mt-4 text-sm" style="color:var(--muted)">{r.note}</p>
  </div>
</section>
<style>
  .tab { transition: background-color .2s, color .2s, transform .18s var(--ease-out-strong); }
  .tab:active { transform: scale(.97); }
  .tab[aria-selected='true'] { background: var(--accent); color: var(--accent-fg); box-shadow: inset 0 -3px 5px rgb(0 0 0 / .2), inset 0 3px 5px rgb(255 255 255 / .3); }
  :global(#route-wrap.is-full) { position: fixed; inset: 0.75rem; z-index: 250; border-radius: 1.5rem; display: flex; flex-direction: column; background: var(--bg); }
  :global(#route-wrap.is-full #route-map) { height: auto; flex: 1; }
</style>
<script>
  // Càrrega mandrosa: Leaflet i les dades GPX només es baixen quan la secció s'acosta
  const panel = document.getElementById('route-panel');
  if (panel) {
    document.querySelectorAll<HTMLElement>('[data-route-link]').forEach((a) => a.addEventListener('click', () => ((window as any).__pendingRoute = a.dataset.routeLink)));
    new IntersectionObserver((en, o) => { if (en[0].isIntersecting) { o.disconnect(); import('../scripts/routes'); } }, { rootMargin: '700px' }).observe(panel);
  }
</script>
