---
import { useT, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<section id="solidari" class="px-5 py-24 sm:px-8">
  <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] p-8 sm:p-14" style="background:linear-gradient(135deg,color-mix(in srgb,var(--green) 22%,var(--bg-2)),var(--bg-2))">
    <svg class="pointer-events-none absolute -right-10 -top-10 w-64 opacity-30" viewBox="0 0 100 100" fill="none" stroke="var(--green)" stroke-width="2" aria-hidden="true"><circle cx="50" cy="50" r="45"/><circle cx="50" cy="50" r="32"/><circle cx="50" cy="50" r="19"/></svg>
    <h2 data-reveal class="relative text-4xl font-extrabold sm:text-6xl">{t.solidarity.title}</h2>
    <p data-reveal class="relative mt-4 max-w-2xl text-lg" style="color:var(--muted)">{t.solidarity.lead}</p>
    <div class="relative mt-12 grid gap-5 md:grid-cols-3">
      {t.solidarity.cards.map((c) => (
        <article data-reveal class="glass card-hover rounded-[1.75rem] p-7">
          <div class="font-display text-7xl font-extrabold leading-none" style="color:var(--green)">{c.big}</div>
          <h3 class="mt-4 text-xl font-bold">{c.label}</h3>
          <p class="mt-2" style="color:var(--muted)">{c.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
