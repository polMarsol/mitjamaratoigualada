---
import { LANGS, LANG_NAMES, useT, type Lang } from '../i18n';
const { lang, path = '' } = Astro.props as { lang: Lang; path?: string };
const t = useT(lang);
const home = `/${lang}/`;
const race = [
  { href: `${home}#modalitats`, label: t.nav.modalities },
  { href: `${home}#recorreguts`, label: t.nav.routes },
  { href: `${home}#inscripcions`, label: t.nav.register },
  { href: `${home}#programa`, label: t.nav.program },
  { href: `${home}#bossa`, label: t.nav.bag },
  { href: `${home}#finishers`, label: t.nav.finishers },
  { href: `${home}shirt/`, label: t.nav.shirt },
  { href: `${home}#solidari`, label: t.nav.solidarity },
  { href: `${home}#faq`, label: t.nav.faq },
];
const main = [
  { href: `${home}results/`, label: t.nav.results },
  { href: `${home}gallery/`, label: t.nav.gallery },
  { href: `${home}rules/`, label: t.nav.rules },
  { href: `${home}volunteers/`, label: t.nav.volunteers },
  { href: `${home}#contacte`, label: t.nav.contact },
];
const cur = (href: string) => (href === `${home}${path}` && path ? 'page' : undefined);
---
<header id="site-header" class="fixed inset-x-0 top-0 z-[100] px-3 pt-3 sm:px-6">
  <div class="glass header-bar mx-auto flex max-w-6xl items-center justify-between gap-3 rounded-full px-4 py-2 sm:px-6">
    <a href={home} class="shrink-0" aria-label="MM Igualada">
      <img src="/brand/logo-horitzontal.svg" alt="MM Igualada" width="1009" height="300" class="logo-light h-9 w-auto sm:h-10" />
      <img src="/brand/logo-horitzontal-blanc.svg" alt="MM Igualada" width="1009" height="300" class="logo-dark h-9 w-auto sm:h-10" />
    </a>

    <nav class="hidden items-center gap-5 xl:gap-7 lg:flex" aria-label="Principal">
      <div class="dd-wrap relative" data-dd>
        <button type="button" class="nav-link flex items-center gap-1 text-sm font-semibold" aria-haspopup="true" aria-expanded="false">
          {t.nav.race}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="dd glass absolute left-0 top-full z-10 mt-3 grid w-56 gap-0.5 rounded-2xl p-2" style="background:color-mix(in srgb,var(--bg) 96%,transparent)">
          {race.map((l) => <a href={l.href} class="rounded-xl px-3 py-2 text-sm font-semibold transition-colors hover:bg-[var(--line)]">{l.label}</a>)}
        </div>
      </div>
      {main.map((l) => <a href={l.href} aria-current={cur(l.href)} class="nav-link text-sm font-semibold">{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden items-center rounded-full p-1 sm:flex" style="background:var(--line)" role="group" aria-label={t.nav.langLabel}>
        {LANGS.map((l) => (
          <a href={`/${l}/${path}`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={LANG_NAMES[l]}
             class:list={['rounded-full px-3 py-1 text-xs font-bold uppercase transition-colors', l === lang ? 'clay !rounded-full !shadow-none' : '']}>{l}</a>
        ))}
      </div>
      <button id="theme-toggle" type="button" aria-label={t.nav.theme} class="glass grid h-10 w-10 place-items-center rounded-full">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
      <a href={`${home}#inscripcions`} class="btn btn-primary hidden !py-2 text-sm xl:inline-flex">{t.cta.register}</a>
      <button id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.nav.menu} class="glass grid h-10 w-10 place-items-center rounded-full lg:hidden">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" hidden class="fixed inset-0 z-[150] overflow-y-auto lg:hidden" role="dialog" aria-modal="true" aria-label={t.nav.menu}>
  <div class="fixed inset-0 backdrop-blur-xl" style="background:color-mix(in srgb,var(--bg) 92%,transparent)" data-menu-close></div>
  <div class="relative flex min-h-full flex-col justify-center gap-1 p-8 pt-24">
    <button type="button" data-menu-close aria-label={t.nav.close} class="glass fixed right-5 top-5 grid h-11 w-11 place-items-center rounded-full">✕</button>
    {main.slice(0, 4).map((l) => <a href={l.href} data-menu-close class="menu-item font-display block py-1.5 text-3xl font-extrabold">{l.label}</a>)}
    <div class="menu-item mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-base font-semibold" style="color:var(--muted)">
      {race.map((l) => <a href={l.href} data-menu-close class="py-1.5">{l.label}</a>)}
      <a href={main[4].href} data-menu-close class="py-1.5">{main[4].label}</a>
    </div>
    <a href={`${home}#inscripcions`} data-menu-close class="menu-item btn btn-primary mt-6 self-start">{t.cta.register} <span class="arrow">→</span></a>
    <div class="menu-item mt-6 flex gap-2">
      {LANGS.map((l) => <a href={`/${l}/${path}`} hreflang={l} lang={l} class:list={['rounded-full px-4 py-2 text-sm font-bold uppercase', l === lang ? 'clay' : 'glass']}>{l}</a>)}
    </div>
  </div>
</div>

<style>
  .header-bar { background: color-mix(in srgb, var(--bg) 82%, transparent); }
  .nav-link { position: relative; padding: .25rem 0; }
  .nav-link::after, .nav-link[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease-out-strong); }
  .nav-link[aria-current='page']::after { transform: scaleX(1); }
  @media (hover: hover) { .nav-link:hover::after { transform: scaleX(1); } }
  :global([data-theme='dark']) .sun, :global([data-theme='light']) .moon { display: none; }
  .dd { opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .2s, transform .25s var(--ease-out-strong), visibility .2s; }
  .dd-wrap:hover .dd, .dd-wrap:focus-within .dd { opacity: 1; visibility: visible; transform: none; }
  .dd-wrap::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: .9rem; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-dd]').forEach((d) => {
    const b = d.querySelector('button')!;
    const set = (v: boolean) => b.setAttribute('aria-expanded', String(v));
    d.addEventListener('mouseenter', () => set(true)); d.addEventListener('mouseleave', () => set(false));
    d.addEventListener('focusin', () => set(true)); d.addEventListener('focusout', (e) => !d.contains(e.relatedTarget as Node) && set(false));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); (document.activeElement as HTMLElement)?.blur?.(); } });
  });
</script>
