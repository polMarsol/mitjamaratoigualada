---
import { useT, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const f = t.contact.fields;
const inputCls = 'field w-full rounded-2xl px-4 py-3.5 text-base min-h-[52px]';
---
<section id="contacte" class="px-5 py-24 sm:px-8">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[.8fr_1.2fr]">
    <div>
      <h2 data-reveal class="text-4xl font-extrabold sm:text-6xl">{t.contact.title}</h2>
      <p data-reveal class="mt-4 text-lg" style="color:var(--muted)">{t.contact.lead}</p>
      <p data-reveal class="glass mt-6 inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold">
        <span class="h-2 w-2 rounded-full" style="background:var(--green)"></span>{t.contact.response}
      </p>
    </div>

    <form id="contact-form" data-form data-reveal class="glass grid gap-5 rounded-[2rem] p-6 sm:p-8" novalidate
          data-msgs={JSON.stringify({ ...t.contact.errors, sending: f.sending, send: f.send, ok: `${t.contact.success} ${t.contact.successNote}` })}>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="c-name" class="mb-1.5 block text-sm font-bold">{f.name}</label>
          <input id="c-name" name="name" type="text" autocomplete="name" data-rule="required" class={inputCls} aria-describedby="c-name-e" />
          <p id="c-name-e" class="err" role="alert"></p>
        </div>
        <div>
          <label for="c-email" class="mb-1.5 block text-sm font-bold">{f.email}</label>
          <input id="c-email" name="email" type="email" autocomplete="email" data-rule="email" class={inputCls} aria-describedby="c-email-e" />
          <p id="c-email-e" class="err" role="alert"></p>
        </div>
      </div>
      <div>
        <label for="c-topic" class="mb-1.5 block text-sm font-bold">{f.topic}</label>
        <select id="c-topic" name="topic" class={inputCls}>{t.contact.topics.map((o) => <option>{o}</option>)}</select>
      </div>
      <div>
        <label for="c-msg" class="mb-1.5 block text-sm font-bold">{f.message}</label>
        <textarea id="c-msg" name="message" rows="5" data-rule="min:10" class={inputCls} aria-describedby="c-msg-e"></textarea>
        <p id="c-msg-e" class="err" role="alert"></p>
      </div>
      <!-- Antispam: camp trampa (honeypot) invisible + temps mínim d'emplenament -->
      <div aria-hidden="true" style="position:absolute;left:-9999px"><label>Web<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <div>
        <label class="flex items-start gap-3 text-sm"><input id="c-consent" name="consent" type="checkbox" data-rule="checked" class="mt-1 h-5 w-5 shrink-0 accent-[var(--accent)]" aria-describedby="c-consent-e" /><span>{f.consent}</span></label>
        <p id="c-consent-e" class="err" role="alert"></p>
      </div>
      <button type="submit" class="btn btn-primary justify-self-start">{f.send}</button>
      <p data-status class="min-h-6 font-semibold" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<style>
  .field { background: var(--bg); border: 1.5px solid var(--line); color: var(--fg); transition: border-color .2s, box-shadow .2s; box-shadow: inset 2px 2px 6px rgb(0 0 0 / .06); }
  .field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent); }
  .field[aria-invalid='true'] { border-color: #dc2626; }
  .err { color: #dc2626; font-size: .85rem; margin-top: .35rem; min-height: 0; }
  :global([data-theme='dark']) .err { color: #ff8a8a; }
  @keyframes shake { 20%,60% { transform: translateX(-6px); } 40%,80% { transform: translateX(6px); } }
  :global(.shake) { animation: shake .4s var(--ease-out-strong); }
</style>
<script>import '../scripts/forms';</script>
