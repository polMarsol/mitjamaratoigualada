---
import type { Shape } from '../data/sponsors';
interface Props { name: string; shape: Shape; color: string; size?: 'lg' | 'md' | 'sm' }
const { name, shape, color, size = 'md' } = Astro.props;
const s = { lg: 56, md: 38, sm: 30 }[size];
---
<span class="inline-flex items-center gap-3" style={`--c:${color}`}>
  <svg width={s} height={s} viewBox="0 0 40 40" aria-hidden="true" class="mark shrink-0">
    {shape === 'mountain' && <path d="M3 33 16 11l7 11 5-7 9 18Z" fill="var(--c)" />}
    {shape === 'wave' && <path d="M2 22q6-12 12 0t12 0 12 0" fill="none" stroke="var(--c)" stroke-width="5" stroke-linecap="round" />}
    {shape === 'leaf' && <path d="M7 33C7 15 19 7 34 7c0 15-8 26-27 26Z" fill="var(--c)" />}
    {shape === 'hex' && <path d="M20 3l14 8v18l-14 8-14-8V11Z" fill="var(--c)" />}
    {shape === 'bolt' && <path d="M23 2 8 23h10l-3 15 17-22H21Z" fill="var(--c)" />}
    {shape === 'ring' && <><circle cx="20" cy="20" r="14" fill="none" stroke="var(--c)" stroke-width="5" /><circle cx="20" cy="20" r="4.5" fill="var(--c)" /></>}
    {shape === 'arrow' && <path d="M5 20h27M21 9l11 11-11 11" fill="none" stroke="var(--c)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />}
    {shape === 'sun' && <><circle cx="20" cy="20" r="8" fill="var(--c)" /><path d="M20 3v6M20 31v6M3 20h6M31 20h6M8 8l4 4M28 28l4 4M32 8l-4 4M12 28l-4 4" stroke="var(--c)" stroke-width="3.5" stroke-linecap="round" /></>}
  </svg>
  <span class:list={['font-display font-extrabold tracking-tight', size === 'lg' ? 'text-3xl' : size === 'md' ? 'text-lg' : 'text-base']} style="color:var(--fg)">{name}</span>
</span>
