---
import { useT, type Lang } from '../i18n';
import { EVENT } from '../data/event';
import { SOCIAL } from '../data/sponsors';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const icons: Record<string, string> = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>',
  facebook: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.500A.5.5 0 0 1 14 8Z"/>',
  x: '<path d="m4 4 16 16M20 4 4 20"/>',
  strava: '<path d="m8 3 5 10h-3.500L8 10l-1.500 3H3L8 3Zm6 10 3 6 3-6h-2.500L17 15.500 15.500 13H14Z"/>',
  youtube: '<rect x="2.500" y="5" width="19" height="14" rx="4"/><path d="m10 9 5 3-5 3V9Z" fill="currentColor"/>',
};
---
<footer class="mt-24 border-t px-6 py-14" style="border-color:var(--line);background:var(--bg-2)">
  <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <a href={`/${lang}/`} aria-label="MM Igualada" class="block w-56">
        <img src="/brand/logo-principal.svg" alt="Mitja Marató d’Igualada" width="576" height="580" class="logo-light h-auto w-full" loading="lazy" />
        <img src="/brand/logo-mono-blanc.svg" alt="Mitja Marató d’Igualada" width="576" height="580" class="logo-dark h-auto w-full" loading="lazy" />
      </a>
      <p class="mt-2 max-w-sm" style="color:var(--muted)">{t.footer.tagline}</p>
      <p class="mt-4 text-sm" style="color:var(--muted)">{t.footer.organised}</p>
      <ul class="mt-6 flex gap-2" aria-label={t.social.label}>
        {SOCIAL.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="glass social grid h-11 w-11 place-items-center rounded-full">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.id]} />
          </a></li>
        ))}
      </ul>
    </div>
    <nav aria-label="Footer" class="text-sm">
      <ul class="grid gap-2 font-semibold">
        <li><a href={`/${lang}/#modalitats`} class="hover:underline">{t.nav.modalities}</a></li>
        <li><a href={`/${lang}/#recorreguts`} class="hover:underline">{t.nav.routes}</a></li>
        <li><a href={`/${lang}/results/`} class="hover:underline">{t.nav.results}</a></li>
        <li><a href={`/${lang}/gallery/`} class="hover:underline">{t.nav.gallery}</a></li>
        <li><a href={`/${lang}/shirt/`} class="hover:underline">{t.nav.shirt}</a></li>
        <li><a href={`/${lang}/rules/`} class="hover:underline">{t.nav.rules}</a></li>
        <li><a href={`/${lang}/volunteers/`} class="hover:underline">{t.nav.volunteers}</a></li>
        <li><a href={`/${lang}/#faq`} class="hover:underline">{t.nav.faq}</a></li>
        <li><a href={`/${lang}/#contacte`} class="hover:underline">{t.nav.contact}</a></li>
      </ul>
    </nav>
    <div class="text-sm" style="color:var(--muted)">
      <a href={`mailto:${EVENT.email}`} class="font-semibold underline decoration-2 underline-offset-4" style="color:var(--fg)">{EVENT.email}</a>
      <ul class="mt-4 grid gap-2">
        <li><a href={`/${lang}/legal/`} class="hover:underline">{t.legalLinks.legal}</a></li>
        <li><a href={`/${lang}/privacy/`} class="hover:underline">{t.legalLinks.privacy}</a></li>
        <li><a href={`/${lang}/cookies/`} class="hover:underline">{t.legalLinks.cookies}</a></li>
        <li><button type="button" data-cookie-settings class="hover:underline">{t.legalLinks.settings}</button></li>
      </ul>
      <p class="mt-5">© 2026 MM Igualada · {t.footer.rights}</p>
      <p class="mt-1">{t.footer.proto}</p>
    </div>
  </div>
</footer>
<style>
  @media (hover: hover) { .social { transition: transform .25s var(--ease-out-strong), background-color .2s; } .social:hover { transform: translateY(-3px); background: var(--accent); color: var(--accent-fg); } }
</style>
