---
import { useT, type Lang } from '../i18n';
import { UDL_DISCOUNT } from '../data/event';
import PriceTable from './PriceTable.astro';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<section id="inscripcions" class="px-5 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <h2 data-reveal class="text-4xl font-extrabold sm:text-6xl">{t.register.title}</h2>
    <p data-reveal class="mt-4 max-w-2xl text-lg" style="color:var(--muted)">{t.register.lead}</p>

    <div data-reveal class="mt-12"><PriceTable lang={lang} /></div>
    <p data-reveal class="mt-3 text-sm" style="color:var(--muted)">{t.register.perks}</p>

    <a data-reveal href={`/${lang}/volunteers/`} class="glass card-hover mt-6 flex flex-wrap items-center gap-3 rounded-2xl px-5 py-4 text-sm font-semibold">
      <span class="clay grid h-9 w-9 shrink-0 place-items-center text-xs font-extrabold" aria-hidden="true">UdL</span>
      <span>{t.register.udl.replace('{n}', String(UDL_DISCOUNT))}</span>
      <span class="ml-auto underline underline-offset-4" style="color:var(--accent)">{t.register.udlLink} →</span>
    </a>

    <div data-reveal class="mt-8 flex flex-wrap items-center gap-4">
      <button type="button" class="btn btn-primary" disabled aria-disabled="true" style="opacity:.85;cursor:not-allowed">{t.register.cta}</button>
      <span class="text-sm" style="color:var(--muted)">{t.register.soon}</span>
    </div>
  </div>
</section>
