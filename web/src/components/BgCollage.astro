---
import { BG_KEYS } from '../data/photos';
// Collage fix de fons: fotos reals pre-difuminades, superposades i amb un vel de color per garantir el contrast del text.
const cols = 5, rows = 4;
const jit = [4, -6, 9, -3, 7, -8, 2, 6, -5, 10, -2, 8, -7, 3, 5, -9, 1, -4, 6, -1];
const tiles = BG_KEYS.slice(0, cols * rows).map((k, i) => {
  const c = i % cols, r = Math.floor(i / cols);
  return {
    k, x: c * (100 / cols) - 8 + jit[i] * 0.9, y: r * (100 / rows) - 8 + jit[(i + 7) % 20] * 0.9,
    w: 34 + (i % 3) * 5, h: 34 + ((i + 1) % 3) * 6, rot: jit[(i + 3) % 20], dur: 34 + (i % 5) * 6,
  };
});
---
<div id="bg-collage" aria-hidden="true">
  {tiles.map((t) => (
    <div class="tile" style={`left:${t.x}vw;top:${t.y}vh;width:${t.w}vw;height:${t.h}vh;--r:${t.rot}deg;--dur:${t.dur}s;background-image:url(/img/bg/${t.k}.webp)`}></div>
  ))}
  <div class="veil"></div>
</div>
